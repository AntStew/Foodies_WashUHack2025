rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Allow read/write only if user is authenticated and owns the document
      allow read, write: if isOwner(userId);

      // Fridge items subcollection
      match /fridgeItems/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // Recipes subcollection
      match /recipes/{recipeId} {
        allow read, write: if isOwner(userId);
      }

      // Shopping list subcollection
      match /shoppingList/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // Suggested stores subcollection
      match /suggestedStores/{storeId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}